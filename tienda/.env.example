# Copia a .env.local. `npm run dev`, los scripts db:* y los tests lo leen.

# docker-compose.local.yaml (npm run db:up). Los tests usan <base>_test, nunca esta.
DATABASE_URL=postgres://nude:nude@localhost:5435/nude_db

# 32+ caracteres: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Registrar <BETTER_AUTH_URL>/api/auth/callback/google en Google Cloud Console.
# En desarrollo son opcionales (scripts/sesion-admin-dev.mjs); en produccion, obligatorias.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos separados por coma que nacen admin (solo al crear la cuenta).
ADMIN_EMAILS=correo@nudesportswear.co

# Cloudflare R2: fotos de producto. Sin R2_ACCOUNT_ID, en desarrollo las fotos van a
# .almacen/ (gitignoreado) y `npm run fotos:subir` llena ese directorio.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
