{
  "name": "tienda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "verificar": "npm run build && node scripts/verificar.mjs",
    "db:generate": "DOTENV_CONFIG_PATH=.env.local drizzle-kit generate",
    "db:migrate": "DOTENV_CONFIG_PATH=.env.local tsx src/db/run-migrate.ts",
    "db:seed": "DOTENV_CONFIG_PATH=.env.local tsx src/db/seed.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "better-auth": "1.5.6",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "next": "16.2.12",
    "postgres": "^3.4.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.63.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
