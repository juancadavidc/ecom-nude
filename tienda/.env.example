# Todas las variables de la tienda. Copia a .env.local: `npm run dev`, los scripts db:*,
# fotos:subir y los tests lo leen. En Coolify van las de "Produccion" (ver
# docker-compose.yaml, que falla el deploy si falta una obligatoria).

# ── Base de datos ──────────────────────────────────────────────────────────────────
# Obligatoria. En local, el Postgres de docker-compose.local.yaml (npm run db:up).
# Los tests usan <base>_test (se crea sola), nunca esta. En produccion, nunca localhost.
DATABASE_URL=postgres://nude:nude@localhost:5435/nude_db

# ── Autenticacion (Better Auth) ────────────────────────────────────────────────────
# Obligatoria. 32+ caracteres de alta entropia: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Obligatoria en produccion: el origen publico https del sitio. En local, el dev server.
BETTER_AUTH_URL=http://localhost:3000

# Login con Google. Registrar <BETTER_AUTH_URL>/api/auth/callback/google en Google Cloud
# Console. En desarrollo son opcionales (se entra con scripts/sesion-admin-dev.mjs); en
# produccion, obligatorias: sin ellas el servidor no arranca.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correos separados por coma que nacen admin (solo al crear la cuenta; despues no
# promueve a nadie). Vacio = nadie nace admin. Nombre anterior: ADMIN_ALLOWLIST (se sigue
# leyendo si ADMIN_EMAILS no esta).
ADMIN_EMAILS=correo@nudesportswear.co

# ── Fotos de producto (Cloudflare R2) ──────────────────────────────────────────────
# Obligatorias en produccion, un bucket por ambiente, token con lectura y escritura.
# Sin R2_ACCOUNT_ID, en desarrollo y tests las fotos van al directorio local de abajo y
# `npm run fotos:subir` lo llena con el catalogo inicial.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Opcional. Directorio del almacen local cuando no hay R2 (por defecto .almacen, gitignoreado).
# ALMACEN_LOCAL_DIR=.almacen

# ── Solo desarrollo ────────────────────────────────────────────────────────────────
# Opcional. Correo de la admin de prueba que crea scripts/sesion-admin-dev.mjs.
# ADMIN_DEV_EMAIL=admin-dev@nude.local

# ── Operacion del contenedor (no van en .env.local) ────────────────────────────────
# SEMBRAR_CATALOGO=si   Permite `node seed.mjs` en produccion. Reemplaza TODO el catalogo:
#                       se pasa solo en esa linea, nunca como variable fija de Coolify.
# SKIP_MIGRATIONS=1     El contenedor arranca sin aplicar migraciones (para inspeccionar).
# MIGRATIONS_DIR=…      Carpeta de migraciones del entrypoint (por defecto, ./migrations).
# TAG=staging|latest    Tag de la imagen en Coolify: staging en staging, latest en produccion.
# PORT=3000             Puerto del servidor dentro del contenedor (la imagen ya lo fija).
# SKIP_ENV_VALIDATION=1 Solo para `next build` sin secretos (lo usa docker/Dockerfile).
